        <div class="party-line"><strong>ДДС №:</strong> {{ supplier.vat_number }}</div>
        <div class="party-line"><strong>Адрес:</strong> {{ supplier.address }}</div>
        <div class="party-line"><strong>МОЛ:</strong> {{ supplier.mol }}</div>
        <div class="party-line"><strong>IBAN:</strong> {{ supplier.iban }} ({{ supplier.bank_name }})</div>
      </td>
      <td>
        <span class="party-badge" style="background-color: #f1f5f9; color: #334155;">Получател / Магазин</span>
        <div class="party-name">{{ buyer.name }}</div>
        <div class="party-line"><strong>ЕИК:</strong> {{ buyer.eik }}</div>
        <div class="party-line"><strong>ДДС №:</strong> {{ buyer.vat_number }}</div>
        <div class="party-line"><strong>Адрес:</strong> {{ buyer.address }}</div>
        <div class="party-line"><strong>МОЛ:</strong> {{ buyer.mol }}</div>
        <div class="party-line"><strong>Имейл:</strong> {{ buyer.email }}</div>
      </td>
    </tr>
  </table>
  <table class="items-table">
    <thead>
      <tr>
        <th style="width: 5%;">#</th>
        <th style="width: 40%;">Артикул / Описание</th>
        <th class="text-center" style="width: 12%;">Баркод (EAN)</th>
        <th class="text-center" style="width: 10%;">Количество</th>
        <th class="text-right" style="width: 15%;">Ед. цена (без ДДС)</th>
        <th class="text-right" style="width: 18%;">Стойност (лв.)</th>
      </tr>
    </thead>
    <tbody>
      {% for item in items %}
      <tr>
        <td>{{ loop.index }}</td>
