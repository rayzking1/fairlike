    setProducts((prev) => prev.filter((p) => p.id !== prodId));
  };

  const handleSaveMoq = async () => {
    setMoqSaved(true);
    const baseUrl = getApiBaseUrl();
    try {
      for (const prod of supplierProducts) {
        await fetch(`${baseUrl}/api/products/${prod.id}`, {
