        <td class="text-center">{{ item.ean }}</td>
        <td class="text-center">{{ item.quantity }} {{ item.unit }}</td>
        <td class="text-right">{{ "%.2f"|format(item.unit_price) }} лв.</td>
        <td class="text-right"><strong>{{ "%.2f"|format(item.total_price) }} лв.</strong></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <table class="summary-table">
    <tr>
      <td class="terms-box">
        <div style="font-weight: 700; color: #0f172a; margin-bottom: 4px;">Банкови детайли и B2B условия:</div>
        <div>Плащането се извършва по банкова сметка на доставчика:</div>
        <div style="margin-top: 3px;"><strong>IBAN:</strong> {{ supplier.iban }} | <strong>BIC:</strong> {{ supplier.bic }}</div>
        <div style="margin-top: 3px;"><strong>Основание за плащане:</strong> Фактура № {{ invoice_number }}</div>
        <div style="margin-top: 6px; font-size: 7.5pt; color: #64748b;">
          * Съгласно Faire B2B условия: Заявката подлежи на 60-дневна гаранция за връщане на непродадени наличности при първоначално зареждане.
        </div>
      </td>
      <td style="width: 5%;"></td>
      <td style="width: 40%;">
        <table class="totals-box">
          <tr>
            <td class="label">Данъчна основа:</td>
            <td class="amount">{{ "%.2f"|format(subtotal) }} лв.</td>
          </tr>
          {% if discount_amount > 0 %}
          <tr>
            <td class="label" style="color: #16a34a;">Отстъпка ({{ discount_percent }}%):</td>
            <td class="amount" style="color: #16a34a;">-{{ "%.2f"|format(discount_amount) }} лв.</td>
          </tr>
          <tr>
            <td class="label">Основа след отстъпка:</td>
            <td class="amount">{{ "%.2f"|format(taxable_base) }} лв.</td>
          </tr>
          {% endif %}
          <tr>
            <td class="label">ДДС ({{ vat_rate }}%):</td>
            <td class="amount">{{ "%.2f"|format(vat_amount) }} лв.</td>
          </tr>
          <tr class="grand-total">
            <td class="label">Общо за плащане:</td>
            <td class="amount">{{ "%.2f"|format(total_due) }} лв.</td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
  <table class="signatures-table">
    <tr>
      <td>
        <div class="sig-line"></div>
        <div><strong>Издал:</strong> {{ supplier.mol }} ({{ supplier.name }})</div>
      </td>
      <td>
        <div class="sig-line"></div>
        <div><strong>Получил:</strong> {{ buyer.mol }} ({{ buyer.name }})</div>
      </td>
    </tr>
  </table>
</body>
