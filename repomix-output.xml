        </div>

        {/* Categories Bar */}
        <div className="max-w-[1360px] mx-auto px-4 sm:px-8 flex items-center gap-6 overflow-x-auto py-2.5 scrollbar-none text-xs font-medium text-[#525252] border-t border-[#F2F0EB]">
